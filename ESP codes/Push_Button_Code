            ".modal .box{background:#fff;padding:22px;border-radius:14px;max-width:320px;text-align:center}"
            ".list{max-height:172px;overflow-y:auto;margin:0 -4px}"
            ".row{padding:7px 4px;font-size:13px;border-bottom:1px solid #eef2f2}"
            ".row:last-child{border-bottom:none}"
            ".row.muted{color:#93a5a5}"
            ".barchart{display:flex;align-items:flex-end;gap:2px;height:64px;"
                "background:#f4f7f8;border-radius:8px;padding:6px 4px}"
            ".bar{flex:1;min-width:0;background:#0a8f5c;border-radius:2px 2px 0 0}"
            ".barlabels{display:flex;justify-content:space-between;font-size:10px;"
                "color:#93a5a5;margin-top:4px;padding:0 2px}"
            "</style></head><body><div class='container'>"
            "<div class='topbar'><div class='logo'>L</div>"
            "<div><div class='mark'>LYRA</div><div class='tagline'>Built for Women's Dignity</div></div>"
            "<div class='verbadge'>" MACHINE_ID "<br>v" FIRMWARE_VERSION "</div></div>"
            "<p id='status'>Syncing time...</p><div class='grid'>";

        html += "<div class='card'><h4>Stock</h4>"
            "<p class='stat'>" + String(stock) + " <span style='font-size:14px;color:#5b7676'>/ " + String(MAX_STOCK)
                + " &middot; <span class='" + (stock == 0 ? "badge-warn'>EMPTY" : "badge-ok'>OK") + "</span></span></p>"
            "<p>Days since last refill: " + String(dsr < 0 ? String("unknown") : String(dsr)) + "</p>"
            "<p>Days empty (last 30 days): " + String(emptyDays30) + "</p></div>";

        html += "<div class='card'><h4>Usage</h4>"
            "<p>Today: <b>" + String(todayCount) + "</b></p>"
            "<p>7d: " + String(sumLastNDays(7, true)) + " &middot; 30d: " + String(sumLastNDays(30, true))
              + " &middot; Lifetime: " + String(totalVendedEver) + "</p></div>";

        html += "<div class='card'><h4>Recent refills</h4><div class='list'>" + recentRefills + "</div></div>";

        html += "<div class='card'><h4>Recent hotspot access</h4><div class='list'>" + recentAccess + "</div></div>";

        html += "<div class='card'><h4>Machine health</h4>"
            "<p>Motor cycles: " + String(motorCycles)
              + (maintDue ? " <span class='badge-warn'>SERVICE DUE</span>" : " <span class='badge-ok'>ok</span>") + "</p>"
            "<p>Reboot count: " + String(rebootCount) + "</p>"
            "<p>RTC battery: " + (rtcLowBattery ? "<span class='badge-warn'>LOW - replace coin cell</span>" : "<span class='badge-ok'>ok</span>") + "</p>"
            "<p>Vend abuse events: " + String(abuseEvents) + " &middot; Lock: " + lockStatus + "</p></div>";

        html += "<div class='card full'><h4>Peak hours (lifetime, by hour of day)</h4><div class='barchart'>";
        for (int h = 0; h < 24; h++) {
            int pct = max(6, (int)(hourCounts[h] * 100L / maxHourCount)); // floor so a zero-count bar is still visible
            html += "<div class='bar' style='height:" + String(pct) + "%' title='" + String(h) + "h: " + String(hourCounts[h]) + "'></div>";
        }
        html += "</div><div class='barlabels'><span>12am</span><span>6am</span><span>12pm</span><span>6pm</span><span>11pm</span></div></div>";

        html += "<div class='card full'>";
        if (maintDue) html += "<p><a class='link' href='/ack_maintenance'>Mark serviced (reset counter)</a></p>";
        html += "<p><a class='btn' href='/usage.csv'>Download usage.csv</a></p></div>";

        html += "</div></div>"; // .grid .container

        html += "<button class='fab' onclick=\"document.getElementById('helpModal').style.display='flex'\">Help</button>";
        html += "<div id='helpModal' class='modal'><div class='box'>"
            "<p><b>This machine's Wi-Fi has no internet.</b></p>"
            "<p>To open the help site, switch off this Wi-Fi (or connect to your mobile data) "
            "in your phone's settings, then tap Continue.</p>"
            "<p><a class='btn' href='https://lyraenterprise.co.in/' target='_blank' rel='noopener'>Continue</a></p>"
            "<p><a class='link' href='#' onclick=\"document.getElementById('helpModal').style.display='none';return false;\">Cancel</a></p>"
            "</div></div>";

        html += "<script>"
            "fetch('/settime?epoch=' + Math.floor(Date.now()/1000) + "
                "'&tzoff=' + (-new Date().getTimezoneOffset()*60))"
            ".then(r=>r.text()).then(t=>document.getElementById('status').innerText=t);"
            "</script></body></html>";
        server.sendHeader("Cache-Control", "no-store");
        server.send(200, "text/html", html);
    });

    server.on("/settime", []() {
        if (!server.hasArg("epoch")) {
            server.send(400, "text/plain", "Missing epoch");
            return;
        }
        time_t epoch = server.arg("epoch").toInt();
        long tzOffset = server.hasArg("tzoff") ? server.arg("tzoff").toInt() : 0;
        // Sanity-check the phone's clock before trusting it - roughly 2023-2033.
        // Rejects garbage/zero values that would otherwise corrupt every date-based feature.
        if (epoch < 1700000000L || epoch > 2000000000L) {
            server.send(400, "text/plain", "Rejected: phone's clock looks wrong");
            return;
        }
        rtc.adjust(DateTime(epoch + tzOffset));
        rtcLowBattery = false;
        prefs.putBool("rtcLowBatt", false);
        checkDayRollover();
        server.send(200, "text/plain", "Clock synced to phone time");
    });

    server.on("/ack_maintenance", []() {
        maintCycles = 0;
        prefs.putUInt("maintCycles", 0);
        server.send(200, "text/html", "Maintenance counter reset. <a href='/'>Back</a>");
    });

    server.on("/usage.csv", []() {
        String csv = "# machine_id," MACHINE_ID "\n";
        csv += "# firmware," FIRMWARE_VERSION "\n";
        csv += "# lifetime_total," + String(totalVendedEver) + "\n";
        csv += "# motor_cycles," + String(motorCycles) + "\n";
        csv += "# reboot_count," + String(rebootCount) + "\n";
        csv += "# rtc_low_battery," + String(rtcLowBattery ? 1 : 0) + "\n";
        csv += "# abuse_events," + String(abuseEvents) + "\n";
        csv += "# maintenance_due," + String(maintCycles >= MAINTENANCE_INTERVAL ? 1 : 0) + "\n";
        csv += "# days_since_refill," + String(daysSinceRefill()) + "\n";
        csv += "# days_empty_last_30," + String(daysEmptyLastNDays(30)) + "\n";
        csv += "# hourly_histogram(0-23),";
        for (int h = 0; h < 24; h++) {
            csv += String(hourCounts[h]) + (h < 23 ? ";" : "");
        }
        csv += "\n";
        csv += "date,transactions,stock_at_end,first_vend_time,last_vend_time\n";

        String keys[MAX_DAYS_KEPT];
        int total = loadManifestKeys(keys, MAX_DAYS_KEPT);
        for (int i = 0; i < total; i++) {
            String k = keys[i];
            uint16_t count = prefs.getUShort(("c" + k).c_str(), 0);
            uint8_t stockEnd = prefs.getUChar(("s" + k).c_str(), 0);
            uint32_t firstE = prefs.getUInt(("f" + k).c_str(), 0);
            uint32_t lastE = prefs.getUInt(("l" + k).c_str(), 0);
            csv += k + "," + String(count) + "," + String(stockEnd) + "," + hhmm(firstE) + "," + hhmm(lastE) + "\n";
        }
        csv += todayKey + "," + String(todayCount) + "," + String(stock) + ","
             + hhmm(firstVendEpoch) + "," + hhmm(lastVendEpoch) + " (today, in progress)\n";

        server.sendHeader("Cache-Control", "no-store"); // browsers must not reuse a stale export after a reboot/update
        server.send(200, "text/csv", csv);
    });

    server.begin();

    unsigned long start = millis();
    while (millis() - start < WIFI_TIMEOUT_MS) {
        server.handleClient();
        checkDayRollover();
        updateUserLed();
        if (millis() < vendLockedUntil) {
            lcdLockoutCountdown();
        } else {
            lcdIdle(); // no-ops unless something changed (e.g. lockout just expired), so it won't
        }              // disturb the "WiFi On" screen during a normal dashboard session
        handlePhysicalButtons(); // machine keeps vending normally while the dashboard is open
        if (wasPressed(WIFI_BUTTON)) break;
    }

    server.stop();
    WiFi.softAPdisconnect(true);
    digitalWrite(STATUS_LED, stock > 0 ? HIGH : LOW);
    lcdIdleDirty = true; // force the idle screen to redraw over the WiFi message
}
