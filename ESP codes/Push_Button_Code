#include <Wire.h>
#include <RTClib.h>          // Adafruit RTClib - install via Library Manager
#include <LiquidCrystal_I2C.h> // install "LiquidCrystal I2C" via Library Manager
#include <Preferences.h>
#include <WiFi.h>
#include <WebServer.h>

// --- Identity ---
#define MACHINE_ID "LYRA-NAPKIN-01"
#define FIRMWARE_VERSION "1.1.0"

// --- Pins ---
// Shared-PCB layout: reuses the same physical pins as the IOT/coin machine firmware
// (Lyra_Vending_Repo/IOT_Wifi_LAN) so both variants can populate the same board.
#define VEND_BUTTON 27   // was COIN_PIN on the IOT board - same INPUT_PULLUP pulse pattern
#define RESET_PIN 21     // was RESET_PIN on the IOT board - already used there to refill stock
#define WIFI_BUTTON 4    // was WIFI_RESET_BUTTON_PIN on the IOT board
#define RELAY_PIN 5      // was TRANSISTOR_BASE on the IOT board - same active-HIGH motor pulse
#define STATUS_LED 2     // was BLUE_LED_PIN on the IOT board - single LED, doubles as the user-facing indicator
                         // (this board has only one LED; solid/slow-blink/fast-blink all show on it)
// DS3231 + LCD share I2C on GPIO13 (SDA) / GPIO14 (SCL) - the ESP32 defaults (21/22) are
// already taken by RESET_PIN and the Ethernet module's CS pin on this shared PCB.
// NOTE: GPIO6-11 are wired to the internal flash chip - never use them for I/O.
// NOTE: GPIO18/19/22/23 are hardwired to the Ethernet module on this PCB - never reassign them.
// GPIO0, 12, 15 are boot-strapping pins, avoided here. GPIO2 is also a strapping pin but is
// safe as a simple output post-boot - this matches the IOT firmware's own proven use of it.

// --- Settings ---
#define MAX_STOCK 25
#define DEBOUNCE_MS 40
#define VEND_RUN_MS 2850
#define MOTOR_TEST_MS 800          // brief pulse for manual motor test, doesn't touch stock
#define MAX_DAYS_KEPT 90           // oldest days drop off the manifest past this
#define WIFI_TIMEOUT_MS 300000UL   // auto-shutoff hotspot after 5 min
#define REFILL_HOLD_MS 2000        // hold reset button this long to confirm refill
#define MOTOR_TEST_HOLD_MS 3000    // hold vend+reset together this long for a motor test
#define VEND_COOLDOWN_MS 1200      // minimum gap enforced between two vends
#define ABUSE_WINDOW_MS 20000      // abuse detection window - must exceed ABUSE_MAX_PRESSES * VEND_RUN_MS,
                                   // since each real vend blocks for VEND_RUN_MS before the next press can register
#define ABUSE_MAX_PRESSES 5        // this many vend presses inside the window = lockout
#define ABUSE_LOCKOUT_MS 60000     // vending disabled for this long after abuse is detected
#define MAINTENANCE_INTERVAL 500   // vend cycles between service reminders
#define ACCESS_LOG_MAX 20          // how many hotspot-open events to remember
#define COMBO_SUPPRESS_MS 400      // ignore vend presses this long around a combo-hold entry/exit

const char* AP_SSID = MACHINE_ID; // tags the hotspot itself so multiple units are distinguishable
const char* AP_PASSWORD = "napkin123"; // change this

RTC_DS3231 rtc;
LiquidCrystal_I2C lcd(0x27, 16, 2); // shares the RTC's I2C bus (SDA=13/SCL=14 on this board); try 0x3F if 0x27 shows nothing
Preferences prefs;
WebServer server(80);

int stock = 0;
uint16_t todayCount = 0;
String todayKey;            // "YYYYMMDD" for the day currently being counted
uint32_t firstVendEpoch = 0; // 0 = no vend yet today
uint32_t lastVendEpoch = 0;

uint32_t totalVendedEver = 0;
uint32_t motorCycles = 0;
uint32_t maintCycles = 0;
uint32_t rebootCount = 0;
uint32_t abuseEvents = 0;
bool rtcLowBattery = false;
String lastRefillDate = "";
uint16_t hourCounts[24];

unsigned long resetHoldStart = 0;
bool resetHoldTriggered = false;
unsigned long comboHoldStart = 0;
bool comboTriggered = false;
bool comboWasActive = false;
unsigned long comboSuppressUntil = 0;
unsigned long vendLockedUntil = 0;
unsigned long lastVendMillis = 0;
unsigned long pressTimes[ABUSE_MAX_PRESSES] = {0};
int pressIndex = 0;

void setup() {
    pinMode(VEND_BUTTON, INPUT_PULLUP);
    pinMode(RESET_PIN, INPUT_PULLUP);
    pinMode(WIFI_BUTTON, INPUT_PULLUP);
    pinMode(RELAY_PIN, OUTPUT);
    pinMode(STATUS_LED, OUTPUT);
    digitalWrite(RELAY_PIN, LOW);

    Wire.begin(13, 14); // SDA=13, SCL=14 - explicit, since defaults (21/22) are taken on this PCB
    lcd.init();
    lcd.backlight();
    lcdMsg("LYRA ENTERPRISES", "Napkin Dispenser");
    delay(1800);

    if (!rtc.begin()) {
        // RTC not found/wired - blink LED and show it on the display so it's obvious at install time
        lcdMsg("LYRA - HW ERROR", "RTC Not Found");
        while (true) {
            digitalWrite(STATUS_LED, !digitalRead(STATUS_LED));
            delay(150);
        }
    }
    if (rtc.lostPower()) {
        // Only true on first power-up or after the coin cell dies.
        rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
        rtcLowBattery = true; // sticky warning, cleared only via /clear_rtc_warning
    }

    prefs.begin("napkin", false);
    stock = prefs.getUChar("stock", MAX_STOCK);
    if (stock > MAX_STOCK) stock = prefs.getUChar("stock_bak", MAX_STOCK); // corrupted primary, fall back

    totalVendedEver = prefs.getUInt("totalEver", 0);
    motorCycles = prefs.getUInt("motorCycles", 0);
    maintCycles = prefs.getUInt("maintCycles", 0);
    abuseEvents = prefs.getUInt("abuseEvents", 0);
    rtcLowBattery = rtcLowBattery || prefs.getBool("rtcLowBatt", false);
    lastRefillDate = prefs.getString("lastRefill", "");

    rebootCount = prefs.getUInt("rebootCount", 0) + 1;
    prefs.putUInt("rebootCount", rebootCount);

    for (int h = 0; h < 24; h++) {
        hourCounts[h] = prefs.getUShort(("h" + String(h)).c_str(), 0);
    }

    todayKey = dateKey(rtc.now());
    todayCount = prefs.getUShort(("c" + todayKey).c_str(), 0);
    firstVendEpoch = prefs.getUInt(("f" + todayKey).c_str(), 0);
    lastVendEpoch = prefs.getUInt(("l" + todayKey).c_str(), 0);

    digitalWrite(STATUS_LED, stock > 0 ? HIGH : LOW);
    updateUserLed();
}

// Writes two lines to the 16x2 LCD, clearing first. Both lines must be <=16 chars.
void lcdMsg(const char* line1, const char* line2) {
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print(line1);
    lcd.setCursor(0, 1);
    lcd.print(line2);
}

// Live countdown while a vend lockout is active: "LYRA - Locked" / "Wait Xs", ticking down
// once per second on its own, no button press needed. Falls back to the idle screen once it expires.
bool lcdWasLocked = false;
int lcdLastStock = -1;
bool lcdLastEmpty = false;
bool lcdIdleDirty = true; // set true on boot so lcdIdle()'s first call always draws

void lcdLockoutCountdown() {
    bool locked = millis() < vendLockedUntil;
    if (!locked) {
        if (lcdWasLocked) lcdIdleDirty = true; // just expired - force the idle screen to redraw
        lcdWasLocked = false;
        return;
    }
    lcdWasLocked = true;

    static unsigned long lastShownSec = 0xFFFFFFFF;
    unsigned long remaining = (vendLockedUntil - millis()) / 1000 + 1;
    if (remaining == lastShownSec) return;
    lastShownSec = remaining;

    char line2[17];
    snprintf(line2, sizeof(line2), "Wait %lus", remaining);
    lcdMsg("LYRA - Locked", line2);
}

// Branded idle screen: "LYRA - Ready"/stock, or "LYRA Enterprises"/"OUT OF STOCK" when empty.
// Only rewrites when something actually changed, so it doesn't flicker every loop() tick.
// lcdIdleDirty forces a redraw once (e.g. right after the WiFi screen was showing something else).
void lcdIdle() {
    bool empty = (stock == 0);
    if (!lcdIdleDirty && stock == lcdLastStock && empty == lcdLastEmpty) return;
    lcdLastStock = stock;
    lcdLastEmpty = empty;
    lcdIdleDirty = false;

    if (empty) {
        lcdMsg("LYRA Enterprises", "OUT OF STOCK");
    } else {
        char line2[17];
        snprintf(line2, sizeof(line2), "Stock: %d/%d", stock, MAX_STOCK);
        lcdMsg("LYRA - Ready", line2);
    }
}

// Single shared LED (this board has only one): solid = ready, slow blink = empty,
// (fast blink is driven separately during dispensing, inside vendNapkin()).
void updateUserLed() {
    if (stock == 0) {
        digitalWrite(STATUS_LED, (millis() / 500) % 2);
    } else {
        digitalWrite(STATUS_LED, HIGH);
    }
}

void loop() {
    checkDayRollover();
    updateUserLed();
    if (millis() < vendLockedUntil) {
        lcdLockoutCountdown();
    } else {
        lcdIdle();
    }
    handlePhysicalButtons();

    if (wasPressed(WIFI_BUTTON)) {
        saveAll();
        runWifiExport();
    }
}

// Vend/refill/motor-test button logic - shared by loop() and the WiFi dashboard's loop,
// so the machine keeps working normally for customers while an admin is browsing the dashboard.
void handlePhysicalButtons() {
    bool vendDown = digitalRead(VEND_BUTTON) == LOW;
    bool resetDown = digitalRead(RESET_PIN) == LOW;
    bool comboActiveNow = vendDown && resetDown;

    // Human fingers can't touch two separate wires/buttons at the exact same instant,
    // so there's always a brief moment on entry AND exit of a combo hold where only one
    // button reads down - that moment looks identical to a real single vend press.
    // Suppress vend-triggering around any combo interaction to avoid an accidental real vend.
    if (comboActiveNow) {
        comboSuppressUntil = millis() + COMBO_SUPPRESS_MS;
        comboWasActive = true;
    } else if (comboWasActive) {
        comboSuppressUntil = millis() + COMBO_SUPPRESS_MS;
        comboWasActive = false;
    }

    // Always poll wasPressed() so its debounce timer stays current even while the
    // combo branch is active below - otherwise releasing one button mid-combo while
    // still holding the other can be misread as a fresh vend press. See vendJustPressed use below.
    bool vendJustPressed = wasPressed(VEND_BUTTON);

    if (comboActiveNow) {
        // Combo hold = manual motor test, doesn't touch stock.
        if (comboHoldStart == 0) comboHoldStart = millis();
        if (!comboTriggered && millis() - comboHoldStart >= MOTOR_TEST_HOLD_MS) {
            comboTriggered = true;
            runMotorTest();
        }
        resetHoldStart = 0;
        resetHoldTriggered = false;
    } else {
        comboHoldStart = 0;
        comboTriggered = false;

        // Hold-to-confirm refill (prevents accidental single-tap refills).
        if (resetDown) {
            if (resetHoldStart == 0) resetHoldStart = millis();
            if (!resetHoldTriggered && millis() - resetHoldStart >= REFILL_HOLD_MS) {
                resetHoldTriggered = true;
                refillStock();
            }
        } else {
            resetHoldStart = 0;
            resetHoldTriggered = false;
        }

        if (vendJustPressed && millis() >= comboSuppressUntil) {
            vendNapkin();
        }
    }
}

// If the real date has changed since we last checked, close out yesterday's record.
void checkDayRollover() {
    String nowKey = dateKey(rtc.now());
    if (nowKey != todayKey) {
        saveAll();
        prefs.putUChar(("s" + todayKey).c_str(), stock);          // stock at day end
        prefs.putUInt(("f" + todayKey).c_str(), firstVendEpoch);  // first vend time
        prefs.putUInt(("l" + todayKey).c_str(), lastVendEpoch);   // last vend time
        addToManifest(todayKey);

        todayKey = nowKey;
        todayCount = 0;
        firstVendEpoch = 0;
        lastVendEpoch = 0;

        // re-check the RTC's own health once a day
        if (rtc.lostPower()) {
            rtcLowBattery = true;
            prefs.putBool("rtcLowBatt", true);
        }
    }
}

String dateKey(DateTime dt) {
    char buf[9];
    snprintf(buf, sizeof(buf), "%04d%02d%02d", dt.year(), dt.month(), dt.day());
    return String(buf);
}

DateTime parseDateKey(const String& key) {
    int y = key.substring(0, 4).toInt();
    int mo = key.substring(4, 6).toInt();
    int d = key.substring(6, 8).toInt();
    return DateTime(y, mo, d, 0, 0, 0);
}

String hhmm(uint32_t epoch) {
    if (epoch == 0) return "-";
    DateTime dt(epoch);
    char buf[6];
    snprintf(buf, sizeof(buf), "%02d:%02d", dt.hour(), dt.minute());
    return String(buf);
}

void refillStock() {
    stock = MAX_STOCK;
    lastRefillDate = todayKey;
    prefs.putString("lastRefill", lastRefillDate);
    appendLog("refillLog", rtc.now().unixtime());
    saveAll();
    digitalWrite(STATUS_LED, HIGH);
    updateUserLed();

    char line2[17];
    snprintf(line2, sizeof(line2), "Stock: %d/%d", stock, MAX_STOCK);
    lcdMsg("LYRA - Refilled!", line2);
    delay(1200);
}

void runMotorTest() {
    lcdMsg("LYRA - Testing", "Motor Running...");
    digitalWrite(RELAY_PIN, HIGH);
    delay(MOTOR_TEST_MS);
    digitalWrite(RELAY_PIN, LOW);
}

void vendNapkin() {
    unsigned long now = millis();
    if (now < vendLockedUntil) return; // abuse lockout active - live countdown is already on the LCD
    if (now - lastVendMillis < VEND_COOLDOWN_MS) return; // cooldown guard
    if (stock == 0) {
        lcdMsg("LYRA Enterprises", "OUT OF STOCK");
        return;
    }

    // Abuse detection: if the last ABUSE_MAX_PRESSES vends all happened within the window, lock out.
    pressTimes[pressIndex] = now;
    pressIndex = (pressIndex + 1) % ABUSE_MAX_PRESSES;
    bool allRecent = true;
    for (int i = 0; i < ABUSE_MAX_PRESSES; i++) {
        if (pressTimes[i] == 0 || now - pressTimes[i] > ABUSE_WINDOW_MS) { allRecent = false; break; }
    }
    if (allRecent) {
        vendLockedUntil = now + ABUSE_LOCKOUT_MS;
        abuseEvents++;
        prefs.putUInt("abuseEvents", abuseEvents);
        lcdMsg("LYRA - Too Fast!", "Locked 60s");
        return;
    }

    lcdMsg("LYRA Dispensing", "Please wait...");
    digitalWrite(RELAY_PIN, HIGH);
    unsigned long vendStart = millis();
    while (millis() - vendStart < VEND_RUN_MS) {
        digitalWrite(STATUS_LED, (millis() / 150) % 2); // fast blink = dispensing, please wait
        delay(10);
    }
    digitalWrite(RELAY_PIN, LOW);

    stock--;
    todayCount++;
    totalVendedEver++;
    motorCycles++;
    maintCycles++;
    lastVendMillis = now;

    DateTime nowDt = rtc.now();
    if (firstVendEpoch == 0) {
        firstVendEpoch = nowDt.unixtime();
        prefs.putUInt(("f" + todayKey).c_str(), firstVendEpoch);
    }
    lastVendEpoch = nowDt.unixtime();
    prefs.putUInt(("l" + todayKey).c_str(), lastVendEpoch);
    // Persisted immediately (not just at day-rollover) so a reboot mid-day doesn't lose today's
    // first/last vend timestamps - todayCount already worked this way, these two didn't.

    int h = nowDt.hour();
    hourCounts[h]++;
    prefs.putUShort(("h" + String(h)).c_str(), hourCounts[h]);

    saveAll();

    if (stock == 0) {
        digitalWrite(STATUS_LED, LOW);
        lcdMsg("LYRA - Enjoy!", "OUT OF STOCK");
    } else {
        char line2[17];
        snprintf(line2, sizeof(line2), "Stock: %d/%d", stock, MAX_STOCK);
        lcdMsg("LYRA - Enjoy!", line2);
    }
    delay(1200);
    updateUserLed();
}

void saveAll() {
    prefs.putUChar("stock", stock);
    prefs.putUChar("stock_bak", stock);
    prefs.putUShort(("c" + todayKey).c_str(), todayCount);
    prefs.putUInt("totalEver", totalVendedEver);
    prefs.putUInt("motorCycles", motorCycles);
    prefs.putUInt("maintCycles", maintCycles);
}

// Keeps a comma-separated list of the last MAX_DAYS_KEPT date keys, so we know
// which per-day entries exist (NVS has no built-in "list all keys" call).
void addToManifest(const String& key) {
    String manifest = prefs.getString("manifest", "");
    if (manifest.indexOf(key) != -1) return;

    manifest += key + ",";

    int count = 0;
    for (unsigned int i = 0; i < manifest.length(); i++) if (manifest[i] == ',') count++;
    while (count > MAX_DAYS_KEPT) {
        int comma = manifest.indexOf(',');
        String oldKey = manifest.substring(0, comma);
        prefs.remove(("c" + oldKey).c_str());
        prefs.remove(("s" + oldKey).c_str());
        prefs.remove(("f" + oldKey).c_str());
        prefs.remove(("l" + oldKey).c_str());
        manifest = manifest.substring(comma + 1);
        count--;
    }

    prefs.putString("manifest", manifest);
}

// Appends a timestamp to a capped log list stored under `key` (used for hotspot access log).
void appendLog(const char* key, uint32_t epoch) {
    String log = prefs.getString(key, "");
    log += String(epoch) + ",";

    int count = 0;
    for (unsigned int i = 0; i < log.length(); i++) if (log[i] == ',') count++;
    while (count > ACCESS_LOG_MAX) {
        int comma = log.indexOf(',');
        log = log.substring(comma + 1);
        count--;
    }
    prefs.putString(key, log);
}

// Returns the date-key list from the manifest as an array, oldest first. Caller provides storage.
int loadManifestKeys(String* out, int maxOut) {
    String manifest = prefs.getString("manifest", "");
    int total = 0;
    int start = 0;
    while (start < (int)manifest.length()) {
        int comma = manifest.indexOf(',', start);
        if (comma == -1) break;
        if (total < maxOut) out[total] = manifest.substring(start, comma);
        total++;
        start = comma + 1;
    }
    return total;
}

// Sums transaction counts over the last n completed days, optionally including today.
long sumLastNDays(int n, bool includeToday) {
    String keys[MAX_DAYS_KEPT];
    int total = loadManifestKeys(keys, MAX_DAYS_KEPT);

    long sum = includeToday ? todayCount : 0;
    int from = total - n;
    if (from < 0) from = 0;
    for (int i = from; i < total; i++) {
        sum += prefs.getUShort(("c" + keys[i]).c_str(), 0);
    }
    return sum;
}

// Counts how many of the last n days ended with zero stock (machine was empty at some point that day).
int daysEmptyLastNDays(int n) {
    String keys[MAX_DAYS_KEPT];
    int total = loadManifestKeys(keys, MAX_DAYS_KEPT);
    int from = total - n;
    if (from < 0) from = 0;

    int emptyDays = 0;
    for (int i = from; i < total; i++) {
        if (prefs.getUChar(("s" + keys[i]).c_str(), 1) == 0) emptyDays++;
    }
    if (stock == 0) emptyDays++; // count today too if currently empty
    return emptyDays;
}

// Returns the last `count` epoch timestamps from a capped log (used for refill/access history).
String formatRecentLog(const char* key, int count) {
    String log = prefs.getString(key, "");
    String entries[ACCESS_LOG_MAX + 1];
    int total = 0, start = 0;
    while (start < (int)log.length()) {
        int comma = log.indexOf(',', start);
        if (comma == -1) break;
        if (total <= ACCESS_LOG_MAX) entries[total] = log.substring(start, comma);
        total++;
        start = comma + 1;
    }
    int from = total - count > 0 ? total - count : 0;
    String out = "";
    for (int i = total - 1; i >= from; i--) { // newest first
        DateTime dt((uint32_t)entries[i].toInt());
        char buf[20];
        snprintf(buf, sizeof(buf), "%04d-%02d-%02d %02d:%02d", dt.year(), dt.month(), dt.day(), dt.hour(), dt.minute());
        out += "<div class='row'>" + String(buf) + "</div>";
    }
    if (out.length() == 0) out = "<div class='row muted'>None yet</div>";
    return out;
}

int daysSinceRefill() {
    if (lastRefillDate.length() == 0) return -1;
    TimeSpan diff = rtc.now() - parseDateKey(lastRefillDate);
    return diff.days();
}

bool wasPressed(int pin) {
    static unsigned long lastPressTime[40] = {0};
    if (digitalRead(pin) == LOW && millis() - lastPressTime[pin] > DEBOUNCE_MS) {
        lastPressTime[pin] = millis();
        return true;
    }
    return false;
}

